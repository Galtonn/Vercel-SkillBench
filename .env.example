# Required for the private recruiter-demo gate.
DEMO_ACCESS_CODE=replace-with-a-long-access-code
DEMO_SESSION_SECRET=replace-with-a-random-32-byte-secret

# Added automatically when Neon is connected through the Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Configure the providers you want recruiters to be able to test.
OPENAI_API_KEY=sk-...
V0_API_KEY=...

# Optional local-only overrides.
SKILLBENCH_MODEL=gpt-4o-mini
SKILLBENCH_DATA_DIR=./data/evaluations
